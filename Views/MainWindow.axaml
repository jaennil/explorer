<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:explorer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="using:Avalonia.Platform.Storage"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="explorer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="explorer">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding StorageItems, Mode=OneWay}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.DataTemplates>

                            <DataTemplate DataType="{x:Type s:IStorageFile}">
                                <StackPanel>
                                    <Image Source="/Assets/avalonia-logo.ico" MaxWidth="128" MaxHeight="128" />
                                    <TextBlock Text="{Binding Name}" MaxWidth="128" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type s:IStorageFolder}">
                                <Button Background="White" Command="{Binding GoToDirectoryCommand}">
                                    <StackPanel>
                                        <Border BorderBrush="Gold" BorderThickness="8" Width="128" Height="128" />
                                        <TextBlock Text="{Binding Name}" MaxWidth="128" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
    </ScrollViewer>

</Window>
